{
  "_description": "Schema for Scenario 2 experiment records. One JSON per experiment run.",
  "_status": "SCHEMA ONLY — no experiments have been run yet",
  "fields": {
    "experiment_id": "string — e.g. S2-ref-cnn, S2-lr-low",
    "model": "string — one of: sync_dual_stream_cnn, clean_async_cnn, cross_attention_transformer",
    "dataset_version": "string — dataset name and version tag after inspection",
    "input_modalities": "list of strings — e.g. ['SAR_T1_VV', 'SAR_T2_VV', 'S2_T1']",
    "sar_channels": "integer — 2 for VV-only T1+T2; 4 for VV+VH T1+T2",
    "optical_channels": "integer — number of optical bands used",
    "learning_rate": "float",
    "batch_size": "integer",
    "epochs": "integer",
    "crop_size": "integer — side length of square crop",
    "crops_per_city": "integer",
    "pos_weight": "float — computed from training split no-change/change ratio",
    "loss_function": "string — e.g. BCEWithLogitsLoss(pos_weight=XX)",
    "optimizer": "string",
    "num_self_blocks": "integer or null — Transformer only",
    "num_cross_blocks": "integer or null — Transformer only",
    "num_heads": "integer or null — Transformer only",
    "embed_dim": "integer or null — Transformer only",
    "num_parameters": "integer",
    "seed": "integer",
    "best_validation_epoch": "integer",
    "best_validation_f1": "float",
    "best_validation_iou": "float",
    "final_test_precision": "float or null",
    "final_test_recall": "float or null",
    "final_test_f1": "float or null",
    "final_test_iou": "float or null",
    "final_test_far": "float or null",
    "test_tp": "integer or null",
    "test_fp": "integer or null",
    "test_fn": "integer or null",
    "test_tn": "integer or null",
    "training_time_seconds": "float",
    "evaluation_time_seconds": "float",
    "checkpoint_path": "string — relative path to best.pt",
    "config_path": "string — relative path to config YAML",
    "notes": "string — any deviations from the reference protocol, warnings, or observations"
  },
