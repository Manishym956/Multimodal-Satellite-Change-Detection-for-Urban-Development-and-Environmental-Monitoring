{
  "purpose": "Pair classification for candidate historical optical months on the locked sites. This is an eligibility inventory, not a temporal-gap performance result.",
  "metadata_rule_evidence": {
    "metadata_json_fields": [
      "aoi_id",
      "year",
      "month",
      "s1",
      "s2",
      "buildings",
      "masked"
    ],
    "bad_data_json_fields": [
      "S1",
      "S2"
    ],
    "s2": "Boolean availability flag on each metadata.json timestep. The file does not record why the flag is false.",
    "bad_s2_index": "Integer position in that site's metadata.json record list, stored in bad_data.json under S2. The repository inspection says these indices must be excluded at load time and attributes the larger S2 count to cloud or mask issues. bad_data.json itself has no reason text.",
    "masked": "Boolean timestep flag in metadata.json. Pairing and inspection code treat masked=true as excluding the timestep. The JSON does not define the flag as cloud cover, no-data, or label masking.",
    "cooccurrence_on_locked_sites_all_months": {
      "records": 670,
      "s2_false": 64,
      "s2_false_and_bad_index": 64,
